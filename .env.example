# ── Firebase web config (safe for client code) ─────────────────────────────
# These identify your Firebase project; they are not secrets. Access control
# comes from Firebase Auth + firestore.rules. Leave them empty to run in the
# labelled DEMO DATA mode (synthetic scenario stored in the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Force demo mode even when Firebase is configured: "demo"
NEXT_PUBLIC_URVARA_DATA_MODE=

# ── Server only (never prefix with NEXT_PUBLIC_) ────────────────────────────
# Service-account JSON on one line. Used by /api/farmers (owner creates a
# farmer login) and by `npm run seed:firestore`. Never commit it.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Sarvam AI speech-to-text for the Farmer Portal voice report. Server only:
# the browser posts audio to /api/speech-to-text, which adds this key. Leave
# empty to use the browser's built-in speech recognition instead.
SARVAM_API_KEY=
# Optional model override (default saaras:v3)
SARVAM_STT_MODEL=
# Optional Sarvam text-to-speech overrides. Defaults: bulbul:v4-flash with a voice per
# language (amit_hi_conversational, dev_en_conversational, anand_pa_conversation).
# A speaker set here is used for every language.
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER=

# Ollama Cloud: writes the short spoken reply to the farmer. Server only; get a
# key at ollama.com/settings/keys. Without it, Sarvam's chat model answers
# (same SARVAM_API_KEY; optional SARVAM_CHAT_MODEL, default
# sarvam-105b-conversations); with neither, Urvara's rule-based answers.
OLLAMA_API_KEY=
# Optional model override (default gemma4:31b)
OLLAMA_MODEL=

# n8n "Autonomous Farm Coordinator" webhook (production URL). Server only: the
# owner's weather replan sends one WEATHER_CHANGED event per affected farm to
# /api/farm-events, which forwards it here. Leave empty to hide the panel.
N8N_FARM_EVENT_URL=
